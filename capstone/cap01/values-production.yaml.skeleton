# CAP01, the production cluster. A skeleton: the keys are here, the values are
# yours.
#
# Three things at once, none of them new: Raft from lesson 3.7, Transit
# auto-unseal from 3.2, TLS from 1.3 and 4.2. Every hard part of this file is
# where two of the three meet, and there are exactly three such places. They
# are marked THINK.
#
#   helm install openbao openbao/openbao --version <chart version> \
#     -n openbao -f values-production.yaml

global:
  tlsDisable: # ?

server:
  image:
    repository: # ?
    tag: # ?

  # THINK 1. Raft opens its bolt file at <path>/vault.db and will not create a
  # missing parent directory. On a fresh three node cluster, what does that
  # mean for every node, and what is the smallest thing that fixes it?
  # Lesson 3.7 hit this on a migrated node.
  extraInitContainers: # ?

  # The seal needs a token on the unsealer. Put it in a Secret and reference it
  # here rather than writing it into this file: the transit seal reads
  # BAO_TOKEN from the environment when its stanza carries no token.
  extraSecretEnvironmentVars:
    - envName: # ?
      secretName: # ?
      secretKey: # ?

  ha:
    enabled: # ?
    replicas: # ?

    raft:
      enabled: # ?
      # Without this the node ids are random UUIDs, which turns list-peers and
      # remove-peer into guesswork at the worst possible moment.
      setNodeId: # ?

      config: |
        ui = true

        listener "tcp" {
          address         = "[::]:8200"
          cluster_address = "[::]:8201"
          tls_cert_file   = # ?
          tls_key_file    = # ?
        }

        storage "raft" {
          # Not /openbao/data itself. Give Raft a directory of its own.
          path = # ?

          # THINK 2. These are https now, not the http of lesson 3.7. A joining
          # node has to verify the leader's certificate, and it needs a trust
          # anchor to do it. Which file, and which key in this stanza?
          #
          # Get it wrong and the joiner reports
          #   x509: certificate signed by unknown authority
          # which reads like a problem with the leader's certificate rather
          # than a missing anchor on the joiner.
          retry_join {
            leader_api_addr = # ?
            # ? = "/openbao/tls/ca.crt"
          }
          # ... one per node.
        }

        # THINK 3. The unsealer has its own certificate, from its own
        # namespace, and it is not the certificate this cluster serves. So the
        # seal stanza needs a trust anchor that the tls volume above does not
        # contain. Where does it come from, and how does it get into the pod?
        seal "transit" {
          address     = # the unsealer's service DNS name, https
          key_name    = # ?
          mount_path  = "transit/"
          tls_ca_cert = # ?
        }

        service_registration "kubernetes" {}

  volumes: # ? two of them
  volumeMounts: # ? two of them

  extraEnvironmentVars:
    BAO_ADDR: # ?
    BAO_CACERT: # ?

  dataStorage:
    enabled: true
    size: 1Gi
    storageClass: # ?

  readinessProbe:
    enabled: true
  livenessProbe:
    enabled: false

# CAP03 injects an Agent sidecar into one of the three microservices, so decide
# now whether the injector is part of this stage or the next one.
injector:
  enabled: # ?
ui:
  enabled: # ?
