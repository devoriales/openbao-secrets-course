# CAP03 microservice B: a third party API key through the External Secrets
# Operator. A skeleton.
#
# WHY THIS SERVICE AND NOT MICROSERVICE A'S CREDENTIAL.
#
# Lesson 5.1 made the argument and 5.4 measured it: ESO copies the value into a
# Kubernetes Secret, which puts it in etcd and in every backup taken while it
# existed. For an API key that rotates when somebody remembers, that is a
# proportionate trade for a mechanism every chart already understands.
#
# For a database credential with a fifteen minute lease it is not, and the
# arithmetic is in lesson 5.1: ninety-six credentials a day through etcd, none of
# which the application would notice changing anyway.
#
# If you wire microservice A through this file instead, everything works. That is
# the problem with it.
---
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: openbao
spec:
  provider:
    # Note which provider. ESO 2.8.0 ships an openBao provider that cannot do
    # Kubernetes auth; lesson 5.4 has the field list and the admission error.
    vault:
      server: # ?
      path: # the K/V mount, not a path inside it
      version: v2
      caProvider:
        type: Secret
        name: # ?
        namespace: # a ClusterSecretStore is cluster scoped, so this is required
        key: ca.crt
      auth:
        kubernetes:
          mountPath: kubernetes
          role: # ?
          serviceAccountRef:
            # THINK. Which ServiceAccount authenticates here: the application's,
            # or the operator's? Whatever you answer, that is the identity your
            # audit log will show in CAP04 for every secret ESO reads, for every
            # namespace.
            name: # ?
            namespace: # ?
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: reporting-api
  namespace: payments
spec:
  refreshInterval: # ?
  secretStoreRef:
    kind: ClusterSecretStore
    name: openbao
  target:
    name: # the Kubernetes Secret ESO will create
    creationPolicy: # ?
  data:
    - secretKey: API_KEY
      remoteRef:
        key: # relative to the store's path
        property: # ?
